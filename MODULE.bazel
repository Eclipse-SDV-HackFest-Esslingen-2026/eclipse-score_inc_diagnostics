module(
    name = "score_inc_diagnostics",
    version = "0.1.0",
)

# Rust rules for Bazel
bazel_dep(name = "rules_rust", version = "0.63.0")

# S-CORE Rust toolchain (Ferrocene)
bazel_dep(name = "score_toolchains_rust", version = "0.9.1")

register_toolchains("@score_toolchains_rust//toolchains/ferrocene:all")

# Fetch the Classic Diagnostic Adapter at a fixed commit (read-only, unmodified)
cda = use_extension("//extensions:cda_repo.bzl", "cda_ext")
use_repo(cda, "classic_diagnostic_adapter")

# Cargo dependency resolution via crate_universe
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "cda_crates",
    cargo_lockfile = "@classic_diagnostic_adapter//:Cargo.lock",
    manifests = [
        "@classic_diagnostic_adapter//:Cargo.toml",
        "@classic_diagnostic_adapter//cda-build:Cargo.toml",
        "@classic_diagnostic_adapter//cda-comm-doip:Cargo.toml",
        "@classic_diagnostic_adapter//cda-comm-uds:Cargo.toml",
        "@classic_diagnostic_adapter//cda-core:Cargo.toml",
        "@classic_diagnostic_adapter//cda-database:Cargo.toml",
        "@classic_diagnostic_adapter//cda-health:Cargo.toml",
        "@classic_diagnostic_adapter//cda-interfaces:Cargo.toml",
        "@classic_diagnostic_adapter//cda-main:Cargo.toml",
        "@classic_diagnostic_adapter//cda-plugin-security:Cargo.toml",
        "@classic_diagnostic_adapter//cda-sovd:Cargo.toml",
        "@classic_diagnostic_adapter//cda-sovd-interfaces:Cargo.toml",
        "@classic_diagnostic_adapter//cda-tracing:Cargo.toml",
        "@classic_diagnostic_adapter//comm-mbedtls/mbedtls-sys:Cargo.toml",
        "@classic_diagnostic_adapter//comm-mbedtls/mbedtls-rs:Cargo.toml",
    ],
)
use_repo(crate, "cda_crates")
